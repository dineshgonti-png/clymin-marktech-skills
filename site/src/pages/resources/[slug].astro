---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedContent } from '../../lib/content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const pages = getPublishedContent();
  return pages.map(page => ({
    params: { slug: page.frontmatter.slug },
    props: { frontmatter: page.frontmatter, rawContent: page.content },
  }));
}

const { frontmatter, rawContent } = Astro.props;
const htmlContent = await Promise.resolve(marked.parse(rawContent));
---

<BaseLayout
  title={frontmatter.title}
  metaTitle={frontmatter.meta_title}
  metaDescription={frontmatter.meta_description}
  canonicalUrl={frontmatter.canonical_url}
  schemaType={frontmatter.schema_type}
  faqs={frontmatter.faqs || []}
  slug={frontmatter.slug}
  keywords={frontmatter.target_keywords}
  pageType={frontmatter.type}
  segment={frontmatter.segment}
  createdDate={frontmatter.created}
  updatedDate={frontmatter.updated}
  ogImage={frontmatter.og_image || ''}
  showMetricsBar={frontmatter.show_metrics === true}
>
  <Fragment set:html={htmlContent} />
</BaseLayout>
